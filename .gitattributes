# Enforce LF line endings in the repo — eliminates CRLF warnings on Windows.
# All text assets committed as LF; Git will convert on checkout (core.autocrlf
# stays untouched on developer machines — only the stored blob is canonical LF).

* text=auto

# Source and config — always LF
*.py    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.txt   text eol=lf
*.sh    text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf
*.toml  text eol=lf

# Jupyter notebooks — LF (diff-friendly)
*.ipynb text eol=lf

# Binary assets — never convert
*.pt    binary
*.bin   binary
*.safetensors binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.mp3   binary
*.mp4   binary
*.wav   binary
*.zip   binary
*.tar   binary
*.gz    binary
